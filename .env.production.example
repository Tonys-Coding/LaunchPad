# Copy this file to .env.production on the server and replace every placeholder.
LAUNCHPAD_RELEASE=beta-1
LAUNCHPAD_DOMAIN=launchpad.example.com
BETA_ALLOWED_EMAILS=first-invite@example.com,second-invite@example.com
MONGO_DATABASE=launchpad
MONGO_ROOT_USERNAME=launchpad_admin
MONGO_ROOT_PASSWORD=generate-a-long-random-database-admin-password
MONGO_APP_USERNAME=launchpad_app
MONGO_APP_PASSWORD=generate-a-different-long-random-app-password
# Generate a key file outside the repository: openssl rand -base64 756 > /secure/path/mongo-replica-set.key
MONGO_REPLICA_SET_KEY_FILE=/secure/path/mongo-replica-set.key
# Pre-provision a private S3-compatible bucket. Use an application credential
# limited to list/read/write/delete objects in only this bucket; do not use an
# account-wide or storage-administrator key. Examples include AWS S3, Cloudflare
# R2, Backblaze B2 S3, or another independently chosen compatible provider.
S3_ENDPOINT_URL=https://replace-with-your-s3-endpoint
S3_ACCESS_KEY=replace-with-bucket-scoped-access-key
S3_SECRET_KEY=replace-with-bucket-scoped-secret-key
S3_BUCKET=replace-with-private-launchpad-bucket
S3_REGION=replace-with-provider-region
MAX_UPLOAD_BYTES=10485760
MAX_FLYER_BYTES=8388608
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_TOKEN_KEY=generate-a-fernet-key
APPLICATION_LIMIT=2000
EVENT_LIMIT=2000
LIBRARY_RECORD_LIMIT=500
ATTACHMENT_TOTAL_BYTES_LIMIT=104857600
BULK_IMPORT_LIMIT=500
LOCAL_OCR_HOURLY_LIMIT=20
AI_FLYER_DAILY_LIMIT=5
RESUME_STUDIO_ENABLED=true
AI_RESUME_MONTHLY_LIMIT=10
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
RECENT_AUTH_SECONDS=900
# Required by scripts/backup-production.sh. Generate with: openssl rand -base64 48
BACKUP_ENCRYPTION_KEY=generate-a-long-random-backup-password
# rclone destination configured on the server. Example: launchpad-backups:production
BACKUP_REMOTE=replace-with-rclone-remote
# Optional HTTPS endpoint that accepts a POST when a production check fails.
ALERT_WEBHOOK_URL=
# Comma-separated IDs shown on chrome://extensions after loading Launchpad.
CHROME_EXTENSION_IDS=
