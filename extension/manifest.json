{
  "manifest_version": 3,
  "name": "Launchpad — Job Tracker",
  "version": "1.8.2",
  "description": "Add applications and private calendar events to your Launchpad account from any tab.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Launchpad"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "tabs", "scripting", "storage", "cookies"],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://api.iconify.design/*"
  ]
}
