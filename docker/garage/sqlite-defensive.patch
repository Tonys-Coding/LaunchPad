+#[cfg(test)]
+mod defensive_tests {
+	use super::*;
+
+	#[test]
+	fn every_initialized_connection_is_defensive() {
+		for sync_mode in [true, false] {
+			let mut db = rusqlite::Connection::open_in_memory().unwrap();
+			configure_connection(&mut db, sync_mode).unwrap();
+			assert!(db.db_config(rusqlite::config::DbConfig::SQLITE_DBCONFIG_DEFENSIVE).unwrap());
+			db.execute("CREATE TABLE example (k BLOB PRIMARY KEY, v BLOB)", []).unwrap();
+			let key = b"'); DROP TABLE example; --";
+			db.execute("INSERT INTO example VALUES (?1, ?2)", params![key.as_slice(), b"value".as_slice()]).unwrap();
+			let value: Vec<u8> = db.query_row("SELECT v FROM example WHERE k = ?1", params![key.as_slice()], |r| r.get(0)).unwrap();
+			assert_eq!(value, b"value");
+		}
+	}
+
+	#[test]
+	fn defensive_mode_blocks_direct_schema_writes() {
+		let mut db = rusqlite::Connection::open_in_memory().unwrap();
+		configure_connection(&mut db, true).unwrap();
+		db.execute("CREATE TABLE example (k BLOB PRIMARY KEY, v BLOB)", []).unwrap();
+		db.pragma_update(None, "writable_schema", true).unwrap();
+		assert!(db.execute("DELETE FROM sqlite_schema WHERE name = 'example'", []).is_err());
+		let count: i64 = db.query_row("SELECT count(*) FROM sqlite_schema WHERE name = 'example'", [], |r| r.get(0)).unwrap();
+		assert_eq!(count, 1);
+	}
+}
