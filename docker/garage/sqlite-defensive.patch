+fn configure_connection(db: &mut rusqlite::Connection, sync_mode: bool) -> rusqlite::Result<()> {
+	// Apply to every pooled connection, including replacements after reconnect.
+	db.set_db_config(rusqlite::config::DbConfig::SQLITE_DBCONFIG_DEFENSIVE, true)?;
+	db.pragma_update(None, "journal_mode", "WAL")?;
+	if sync_mode {
+		db.pragma_update(None, "synchronous", "NORMAL")?;
+	} else {
+		db.pragma_update(None, "synchronous", "OFF")?;
+	}
+	Ok(())
+}
