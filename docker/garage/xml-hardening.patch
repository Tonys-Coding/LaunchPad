@@ -46,3 +46,51 @@ impl From<&str> for Value {
 #[derive(Debug, ToSchema, Serialize, Deserialize, PartialEq, Eq, PartialOrd, Ord, Clone)]
 #[schema(as = xml::IntValue)]
 pub struct IntValue(#[serde(rename = "$value")] pub i64);
+
+#[cfg(test)]
+mod security_regressions {
+	use super::Value;
+	use std::time::{Duration, Instant};
+
+	#[test]
+	fn namespace_declarations_are_bounded() {
+		let mut xml = String::from("<Value");
+		for n in 0..257 {
+			xml.push_str(&format!(" xmlns:p{n}=\"urn:trial:{n}\""));
+		}
+		xml.push_str(">safe</Value>");
+		let error = quick_xml::de::from_str::<Value>(&xml).unwrap_err();
+		assert!(error.to_string().to_lowercase().contains("namespace"), "{}", error);
+	}
+
+	#[test]
+	fn duplicate_attribute_checks_remain_enabled() {
+		let mut reader = quick_xml::Reader::from_str(
+			"<Value repeated=\"one\" repeated=\"two\">safe</Value>"
+		);
+		let quick_xml::events::Event::Start(tag) = reader.read_event().unwrap() else {
+			panic!("expected start tag");
+		};
+		assert!(tag.attributes().any(|attribute| attribute.is_err()));
+	}
+
+	#[test]
+	fn large_attribute_list_finishes_within_budget() {
+		let mut xml = String::from("<Value");
+		for n in 0..25_000 {
+			xml.push_str(&format!(" a{n}=\"x\""));
+		}
+		xml.push_str(">safe</Value>");
+		assert!(xml.len() < 1_000_000);
+		let start = Instant::now();
+		let mut reader = quick_xml::Reader::from_str(&xml);
+		let quick_xml::events::Event::Start(tag) = reader.read_event().unwrap() else {
+			panic!("expected start tag");
+		};
+		let attributes = tag.attributes().collect::<Result<Vec<_>, _>>().unwrap();
+		assert_eq!(attributes.len(), 25_000);
+		let value = quick_xml::de::from_str::<Value>(&xml).unwrap();
+		assert_eq!(value.0, "safe");
+		assert!(start.elapsed() < Duration::from_secs(10));
+	}
+}
