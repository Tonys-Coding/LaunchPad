MONGO_URL=mongodb://localhost:27017
DB_NAME=launchpad
# Production deployments can authenticate without embedding credentials in the URL.
# MONGO_USERNAME=launchpad
# MONGO_PASSWORD=replace-this
# MONGO_AUTH_SOURCE=admin
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Production beta access and security. Local development defaults to open registration.
PRODUCTION_MODE=false
API_DOCS_ENABLED=true
RATE_LIMITING_ENABLED=false
SIGNUP_MODE=open
# BETA_ALLOWED_EMAILS=first@example.com,second@example.com
TRUSTED_HOSTS=*

# Local HTTP development uses false. Set true when served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Google OAuth is enabled only when all three values are present.
PUBLIC_BASE_URL=http://localhost:8080
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_TOKEN_KEY=generate-a-fernet-key

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=launchpad
S3_SECRET_KEY=launchpad-local-secret
S3_BUCKET=launchpad
S3_REGION=us-east-1
STORAGE_REQUIRED=true
MAX_UPLOAD_BYTES=10485760
MAX_FLYER_BYTES=8388608

# Optional, click-only flyer enhancement. Google no longer offers 2.5 Flash-Lite to new API users.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_FLYER_DAILY_LIMIT=20
RESUME_STUDIO_ENABLED=true
AI_RESUME_MONTHLY_LIMIT=10
LOCAL_OCR_HOURLY_LIMIT=20
APPLICATION_LIMIT=2000
EVENT_LIMIT=2000
LIBRARY_RECORD_LIMIT=500
ATTACHMENT_TOTAL_BYTES_LIMIT=104857600
BULK_IMPORT_LIMIT=500
RECENT_AUTH_SECONDS=900

# Only use the wildcard Chrome-extension origin in local development.
ALLOW_ALL_CHROME_EXTENSIONS=true
# Public deployments must disable the wildcard and list installed extension IDs.
# CHROME_EXTENSION_IDS=abcdefghijklmnopabcdefghijklmnop

# Optional sample data. Leave disabled for a clean database.
SEED_DEMO_DATA=false
# DEMO_EMAIL=demo@example.com
# DEMO_PASSWORD=replace-this
