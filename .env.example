# Copy to .env only when you want to override these local defaults.
LAUNCHPAD_PORT=8080
MONGO_DATABASE=launchpad
MINIO_ROOT_USER=launchpad
MINIO_ROOT_PASSWORD=launchpad-local-secret
S3_BUCKET=launchpad
MAX_UPLOAD_BYTES=10485760
MAX_FLYER_BYTES=8388608
# Optional, click-only flyer enhancement using the lowest-cost supported model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_FLYER_DAILY_LIMIT=20
RESUME_STUDIO_ENABLED=true
AI_RESUME_MONTHLY_LIMIT=10
SESSION_DAYS=30

# Optional Google OAuth web client. Leave blank to hide Google sign-in.
PUBLIC_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required to enable encrypted Google Calendar connections.
# Generate once with: openssl rand -base64 32 | tr '+/' '-_'
GOOGLE_CALENDAR_TOKEN_KEY=

# A clean database is the default. Set true only when you want sample records.
SEED_DEMO_DATA=false
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=choose-a-local-password
